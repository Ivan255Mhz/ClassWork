@host = https://localhost:7059

###
# Проверка доступности БД
GET {{host}}/api/home

###
# Все игрушки
GET {{host}}/api/toy
Accept: application/json

###
# Игрушка по id
GET {{host}}/api/toy/1
Accept: application/json

###
# Тестовая ошибка (глобальный ExceptionHandlingMiddleware)
GET {{host}}/api/toy/error

###
# Создать игрушку
POST {{host}}/api/toy
Content-Type: application/json

{
  "name": "Обруч",
  "prise": 550,
  "categoryId": 1,
  "manufacturerId": 1
}

###
# Категории
GET {{host}}/api/category
Accept: application/json

###
POST {{host}}/api/category/Спорт

###
DELETE {{host}}/api/category/1

###
# Производители
GET {{host}}/api/manufacturer
Accept: application/json

###
POST {{host}}/api/manufacturer/ДетскийМир

###
# Логин: получаем JWT
# @name login
POST {{host}}/api/auth/login?userName=admin&password=1234

###
@token = {{login.response.body.token}}

# Endpoint с политикой OnlyAdmin
GET {{host}}/api/test/1
Authorization: Bearer {{token}}

###
# Endpoint с ApiKeyAuthFilter
POST {{host}}/api/test
X-Api-Key: demo-key
Content-Type: application/json

{
  "name": "Кубик",
  "prise": 100,
  "categoryId": 1,
  "manufacturerId": 1
}

###
# Состояние фоновых задач
GET {{host}}/api/test/state

###
# Демонстрация exception-фильтра
GET {{host}}/api/test/test
