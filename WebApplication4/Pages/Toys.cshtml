@page
@model WebApplication4.Pages.ToysModel

<h1>Игрушки</h1>

@if (!Model.Toys.Any())
{
    <p>Игрушек пока нет.</p>
}
else
{
    foreach (var toy in Model.Toys)
    {
        <p>@toy.Name — @toy.Prise</p>
    }
}

<form method="post">
    <input asp-for="NewToyName" placeholder="Название игрушки" required />
    <input asp-for="NewToyPrise" placeholder="Цена игрушки" required />
    <button type="submit">Отправить</button>
</form>
